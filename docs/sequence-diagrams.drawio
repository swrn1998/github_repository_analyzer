<mxfile host="app.diagrams.net">
  <diagram name="SD-01: Analyze Repository - Happy Path" id="sequence-1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Actors and Components -->
        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="30" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="ui" value="React UI" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="140" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="ctrl" value="AnalyzerController" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="120" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="cache" value="CacheService" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="ghclient" value="GitHubApiClient" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="120" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="github" value="GitHub API" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="score" value="HealthScoreCalculator" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="140" height="600" as="geometry"/>
        </mxCell>
        
        <mxCell id="alert" value="AlertEngine" style="shape=umlLifeline;perimeter=lifelinePerimeter;" vertex="1" parent="1">
          <mxGeometry x="1060" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        
        <!-- Interactions -->
        <mxCell id="msg1" value="Enter owner/repo" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="user" target="ui">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg2" value="POST /api/analyze" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ui" target="ctrl">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg3" value="get(owner/repo)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ctrl" target="cache">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg4" value="MISS" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="cache" target="ctrl">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg5" value="fetchRepoDetails()" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ctrl" target="ghclient">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg6" value="GET /repos/{owner}/{repo}" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ghclient" target="github">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg7" value="RepoDetails JSON" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="github" target="ghclient">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg8" value="RepoDetailsDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="ghclient" target="ctrl">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg9" value="calculate(repo, commits)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ctrl" target="score">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg10" value="HealthScore (0-100)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="score" target="ctrl">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg11" value="evaluate(repo, commits)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ctrl" target="alert">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg12" value="List&lt;Alert&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="alert" target="ctrl">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg13" value="put(key, response, TTL)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="ctrl" target="cache">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg14" value="AnalysisResponse (source=LIVE)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="ctrl" target="ui">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg15" value="Render Dashboard" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1" source="ui" target="user">
          <mxGeometry width="80" relative="1" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
  
  <diagram name="SD-02: Cache Hit" id="sequence-2">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
