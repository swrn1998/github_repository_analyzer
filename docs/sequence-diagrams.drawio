        <mxCell id="1" parent="0"/>
        
        <mxCell id="note-stale" value="Stale-while-revalidate strategy:&#10;Returns expired entry if exists" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="220" height="70" as="geometry"/>
        </mxCell>
        
        <!-- This diagram follows same pattern but shows error handling -->
        <mxCell id="title3" value="GitHub API Failure → Stale Cache Fallback" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
